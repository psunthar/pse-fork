# Ignore everything by default
*

# But don't ignore these specific files and directories:

# Allow the pse source code directory and all its contents
!pse/
!pse/**

# Allow CMakeLists.txt in root
!CMakeLists.txt

# Allow examples directory but only specific files
!examples/
examples/*
!examples/run.py
!examples/run_gpt_working.py

# Don't ignore .gitignore itself
!.gitignore
